# Defaults to local paper mode. Real trading requires explicit activation in the UI.
# Never commit credentials.
DATABASE_URL=sqlite:///./data/trading.db
# PostgreSQL: postgresql+psycopg://trading:change-me@localhost:5432/trading
MARKET_SOURCE=demo
SCAN_INTERVAL_SECONDS=30
API_HOST=127.0.0.1
API_PORT=8010
# Required for non-loopback deployment; never place this in VITE_* variables.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
# IEX volume is a single venue. SIP entitlement is needed for consolidated volume.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
MARKET_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META,GOOGL,AVGO,JPM,LLY,COST,SPY
# Activate/stop real trading in Settings after scope, preview and confirmation.
# API or trading worker restarts always disarm execution.
# ROBINHOOD_LIVE_ENABLED is deprecated and no longer controls trade permission.
# Existing values are ignored; no environment flag is needed to use the UI button.
# Optional path; default is a separate *.robinhood.sqlite3 beside the primary DB.
ROBINHOOD_LIVE_LEDGER=
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# Web UI uses its own OAuth grant in data/robinhood-oauth.json (0600).
# Connect from http://127.0.0.1:8010/#settings; no token copy/paste is needed.
# The legacy variables below are for standalone adapter use, not web authorization.
ROBINHOOD_ACCESS_TOKEN=
ROBINHOOD_TOKEN_FILE=
ROBINHOOD_CAPABILITY_MAP=
ROBINHOOD_EXECUTION_ACCOUNT=
# Fill only with OAuth metadata returned by official authorization discovery.
ROBINHOOD_OAUTH_TOKEN_URL=
ROBINHOOD_OAUTH_CLIENT_ID=
ROBINHOOD_REFRESH_TOKEN=
